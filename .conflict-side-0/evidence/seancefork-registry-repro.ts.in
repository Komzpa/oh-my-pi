import * as fs from "node:fs";
import * as path from "node:path";
import { AgentRegistry } from "../packages/coding-agent/src/registry/agent-registry";
import { registerPersistedSubagents } from "../packages/coding-agent/src/registry/persisted-agents";
import { registerPersistedSubagents as beforeRegister } from "../packages/coding-agent/src/registry/persisted-agents.before";
const [mode, dir] = process.argv.slice(2);
const root = path.resolve(dir, "root.jsonl"), child = path.resolve(dir, "root/RecoverLabelFeedback.jsonl");
fs.writeFileSync(root, '');
const registry = new AgentRegistry();
const io = () => Number(fs.readFileSync("/proc/self/io", "utf8").match(/rchar: (\d+)/)![1]);
let last = performance.now(), maximum = 0;
const timer = setInterval(() => { const now=performance.now(); maximum=Math.max(maximum,now-last); last=now; },10);
const observations = [];
for (let turn=0; turn<3; turn++) {
 if (turn) fs.appendFileSync(child, JSON.stringify({ type: "model_usage", id: `probe-${turn}`, parentId: null, timestamp: new Date().toISOString(), usage: {cost: { total: 0.125 }}})+'\n');
 await Bun.sleep(20); maximum=0;
 const bytes=io(), start=performance.now();
 await (mode === "before" ? beforeRegister : registerPersistedSubagents)(registry, root);
 const wallMs=performance.now()-start, rcharBytes=io()-bytes;
 await Bun.sleep(20);
 observations.push({turn,wallMs,maxIntervalMs:maximum,rcharBytes,directCost:registry.get("RecoverLabelFeedback")?.history?.directCost});
}
clearInterval(timer);
console.log(JSON.stringify({mode,observations},null,2));
