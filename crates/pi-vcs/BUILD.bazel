load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# Target configuration (not a build-host tool): embedded into the native library.
rust_binary(
    name = "argv0_launcher",
    srcs = ["src/argv0_launcher.rs"],
    crate_root = "src/argv0_launcher.rs",
    edition = "2024",
    rustc_flags = [
        "-Copt-level=z",
        "-Ccodegen-units=1",
        "-Cpanic=abort",
        "-Cstrip=symbols",
    ] + select({
        "//bazel/variants:baseline": ["-Ctarget-cpu=x86-64-v2"],
        "//bazel/variants:modern": ["-Ctarget-cpu=x86-64-v3"],
        "//conditions:default": [],
    }) + select({
        "//bazel/triples:x86_64-unknown-linux-musl": ["-Ctarget-feature=-crt-static"],
        "//bazel/triples:aarch64-unknown-linux-musl": ["-Ctarget-feature=-crt-static"],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

rust_library(
    name = "pi-vcs",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "pi_vcs",
    compile_data = select({
        "@platforms//os:linux": [":argv0_launcher"],
        "//conditions:default": [],
    }),
    rustc_env = select({
        "@platforms//os:linux": {"OMP_ARGV0_LAUNCHER": "$(execpath :argv0_launcher)"},
        "//conditions:default": {},
    }),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "17.1.5",
    deps = all_crate_deps(normal = True) + [
        "//crates/pi-iso",
        "//crates/vendor/brush-core",
    ],
)

rust_test(
    name = "pi-vcs_test",
    crate = ":pi-vcs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)
