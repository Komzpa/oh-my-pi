{
	"type": "module",
	"private": true,
	"name": "@oh-my-pi/reemxy-extensions",
	"version": "18.3.0",
	"description": "Reemxy-local OMP extensions packaged with the OMP fork",
	"homepage": "https://omp.sh",
	"author": { "name": "Stencil Labs, Inc.", "url": "https://stencil.so" },
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/reemxy-extensions"
	},
	"files": [
		"extensions"
	],
	"exports": {
		"./goal_deadlines": {
			"types": "./extensions/goal_deadlines.ts",
			"import": "./extensions/goal_deadlines.ts"
		},
		"./todo_dispatch": {
			"types": "./extensions/todo_dispatch.ts",
			"import": "./extensions/todo_dispatch.ts"
		},
		"./agent_router": {
			"types": "./extensions/agent_router.ts",
			"import": "./extensions/agent_router.ts"
		},
		"./jev_compaction": {
			"types": "./extensions/jev_compaction.ts",
			"import": "./extensions/jev_compaction.ts"
		}
	},
	"omp": {
		"extensions": [
			"extensions/goal_deadlines.ts",
			"extensions/todo_dispatch.ts",
			"extensions/agent_router.ts"
		]
	},
	"scripts": {
		"check": "bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test --parallel extensions/*.test.ts"
	},
	"dependencies": {
		"@oh-my-pi/pi-agent-core": "catalog:",
		"@oh-my-pi/pi-coding-agent": "catalog:",
		"@oh-my-pi/pi-tui": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"zod": "^3.25.76"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
